@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@inject IisSiteService Sites
@inject DeploymentStore Store
@inject DeploymentService Deployments
@inject IOptions<DeploymentOptions> DeploymentOptions
<PageTitle>Sites</PageTitle>
@if (_sites.Count == 0)
{
    <p role="status">@EmptyStateMessage</p>
}
<div class="site-grid">
@foreach (var site in _sites)
{
    var archives = Store.Archives(site.Id);
    var parentId = site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId;
    var parent = site.TargetKind == TargetKind.Application
        ? _sites.FirstOrDefault(x => string.Equals(x.Id, parentId, StringComparison.OrdinalIgnoreCase)) ?? Store.Site(parentId)
        : null;
    var displayName = site.TargetKind == TargetKind.Application
        ? ApplicationTargetIdentity.DisplayNameForApplication(parent?.Name, site.Name, site.ApplicationPath)
        : site.Name;
    var parentBusy = Busy(parentId);
    <section class="site-card" aria-labelledby="site-@site.Id">
        <div class="card-head">
            <h2 id="site-@site.Id">@displayName</h2>
        </div>
        @if (site.TargetKind == TargetKind.Application)
        {
            <p><strong>Parent:</strong> @site.ParentSiteId <strong>Route:</strong> <code>@site.ApplicationPath</code></p>
        }
        <p><strong>Path:</strong> <code>@site.PhysicalPath</code></p>
        <p><strong>Bindings:</strong> @site.BindingsJson</p>
        <fieldset class="current-status">
            <legend>Current status</legend>
            <p><span class="pill @site.IisState.ToLowerInvariant()">IIS: @site.IisState</span> <span class="pill @site.Health.ToString().ToLowerInvariant()">Health: @site.Health</span></p>
            <p><strong>Last observation:</strong> @(site.LastObservedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "never")</p>
            <p role="status">@site.HealthReason</p>
        </fieldset>
        @if (!site.TargetAvailable)
        {
            <p role="status" class="muted">This target is unavailable in IIS. History is retained; rediscovery is required before deployment.</p>
        }
        @if (parentBusy)
        {
            <p role="status">Parent site busy: @ParentBusyMessage(parentId)</p>
        }
        <label>Healthcheck endpoint <input value="@site.HealthEndpoint" @onchange="e => SaveEndpoint(site, e.Value?.ToString())" aria-describedby="endpoint-help-@site.Id" disabled="@(!site.TargetAvailable || ActiveDeployment(site))" /></label>
        @if (site.Operation == OperationPhase.RecoveryRequired)
        {
            <Button @onclick="() => AcknowledgeRecovery(site)" disabled="@(!site.TargetAvailable || RecoveryBlocked(site))">Acknowledge recovery evidence</Button>
        }
        <div class="actions">
            @if (site.TargetAvailable && !parentBusy)
            {
                <fieldset class="restore-controls">
                    <legend>Restore specific version</legend>
                    <select @bind="_selected[site.Id]" aria-label="Version">
                        <option value="0">Select version</option>
                        @foreach (var archive in archives)
                        {
                            <option value="@archive.Id">@archive.CreatedUtc.ToLocalTime():g — @archive.OriginalName</option>
                        }
                    </select>
                    <Button @onclick="() => Restore(site)" disabled="@(Selected(site.Id) is null)">Restore</Button>
                </fieldset>
                <label class="upload-zone" for="upload-@site.Id">
                    <strong>Drop ZIP here</strong> or <span class="picker-link">choose a ZIP file</span>
                    <InputFile id="@($"upload-{site.Id}")" OnChange="e => Upload(site, e)" accept=".zip,application/zip" aria-label="Upload ZIP" />
                </label>
            }
        </div>
        @if (_busy.Contains(site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId))
        {
            <progress aria-label="Deployment in progress"></progress>
        }
        @if (site.Operation is not (OperationPhase.None or OperationPhase.Completed or OperationPhase.Failed))
        {
            <p role="status">Server operation: @site.Operation</p>
        }
        @if (_messages.TryGetValue(site.Id, out var message))
        {
            <p role="status">@message</p>
        }
    </section>
}
</div>
@if (_wrapperModal)
{
    <div class="modal-backdrop" role="presentation">
        <section class="modal" role="dialog" aria-modal="true" aria-labelledby="wrapper-error-title">
            <h2 id="wrapper-error-title">Upload rejected</h2>
            <p>Bản build không được nằm trong thư mục của tệp nén</p>
            <Button @onclick="CloseWrapperModal">Close</Button>
        </section>
    </div>
}
@code {
    private List<SiteRecord> _sites = [];
    private IisDiscoveryStatus _discoveryStatus = IisDiscoveryStatus.DiscoveryFailure;
    private string? _discoveryFailure;
    private readonly Dictionary<string, string> _messages = [];
    private readonly Dictionary<string, long> _selected = [];
    private readonly HashSet<string> _busy = [];
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private bool _wrapperModal;
    private IReadOnlyList<ParentReservation> _reservations = [];
    private PeriodicTimer? _reservationTimer;
    private CancellationTokenSource? _refreshCancellation;
    protected override void OnInitialized() => Refresh();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _refreshCancellation = new CancellationTokenSource();
        _reservationTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = RefreshReservationsAsync(_refreshCancellation.Token);
    }
    private async Task RefreshReservationsAsync(CancellationToken token)
    {
        try
        {
            while (await _reservationTimer!.WaitForNextTickAsync(token))
            {
                await _refreshLock.WaitAsync(token);
                try
                {
                    var discovery = Sites.Snapshot;
                    var reservations = Store.Reservations();
                    await InvokeAsync(() => { _sites = discovery.Sites.ToList(); _discoveryStatus = discovery.Status; _discoveryFailure = discovery.FailureMessage; _reservations = reservations; PreserveState(); StateHasChanged(); });
                }
                finally { _refreshLock.Release(); }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        _refreshCancellation?.Cancel();
        _reservationTimer?.Dispose();
        _refreshCancellation?.Dispose();
        _refreshLock.Dispose();
    }
    private async void Refresh()
    {
        var discovery = await Sites.WaitForSnapshotAsync(CancellationToken.None);
        _discoveryStatus = discovery.Status;
        _discoveryFailure = discovery.FailureMessage;
        var discovered = discovery.Sites;
        var current = Store.Sites().ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase);
        _sites = discovered.Select(site => current.GetValueOrDefault(site.Id) ?? site).ToList();
        _reservations = Store.Reservations().ToArray();
        foreach (var site in _sites)
        {
            _selected.TryAdd(site.Id, 0);
            _messages.TryAdd(site.Id, "");
        }
    }
    private void PreserveState()
    {
        var current = Store.Sites().ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase);
        _sites = _sites.Select(site => current.GetValueOrDefault(site.Id) ?? site).ToList();
        _reservations = Store.Reservations().ToArray();
        foreach (var site in _sites) { _selected.TryAdd(site.Id, 0); _messages.TryAdd(site.Id, ""); }
    }
    private string EmptyStateMessage => _discoveryStatus switch
    {
        IisDiscoveryStatus.NonWindowsPlatform => "IIS discovery is unavailable because this application is running on a non-Windows platform.",
        IisDiscoveryStatus.NoMatchingConfiguredSitePrefix => "No IIS sites match the configured site-name prefix.",
        IisDiscoveryStatus.MatchingSitesExcludedDashboard => "Matching IIS sites were found, but all were excluded because they are the dashboard site.",
        IisDiscoveryStatus.DiscoveryFailure => $"IIS discovery failed: {_discoveryFailure ?? "the IIS configuration could not be read"}",
        _ => "No matching IIS sites were discovered."
    };
    private bool Busy(string id) => _busy.Contains(id) || _reservations.Any(x => string.Equals(x.ParentSiteId, id, StringComparison.OrdinalIgnoreCase));
    private static bool ActiveDeployment(SiteRecord site) => site.Operation is OperationPhase.Staging or OperationPhase.Snapshot or OperationPhase.Quiescing or OperationPhase.Deploying or OperationPhase.Verifying or OperationPhase.Restoring;
    private bool RecoveryBlocked(SiteRecord site) => _reservations.Any(x => string.Equals(x.ParentSiteId, site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId, StringComparison.OrdinalIgnoreCase) && !(x.TargetId == site.Id && x.Status == "RecoveryRequired"));
    private string ParentBusyMessage(string parentId)
    {
        var reservation = _reservations.FirstOrDefault(x => string.Equals(x.ParentSiteId, parentId, StringComparison.OrdinalIgnoreCase));
        return reservation is null ? "local operation" : $"{reservation.Operation} on target {reservation.TargetId} ({reservation.Status})";
    }
    private ArchiveRecord? Selected(string id) => _selected.GetValueOrDefault(id) is var value && value > 0 ? Store.Archive(value) : null;
    private void SaveEndpoint(SiteRecord site, string? value)
    {
        try { Sites.SaveEndpoint(site, value ?? "/"); _messages[site.Id] = "Saved."; }
        catch (Exception ex) { _messages[site.Id] = ex.Message; }
    }
    private async Task AcknowledgeRecovery(SiteRecord site)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Acknowledge the recovery snapshot and staging evidence? This permits a new deployment but does not delete recovery evidence.")) return;
        try { if (!Sites.IsCurrentTarget(site) || !Store.AcknowledgeRecovery(site.Id, site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId)) _messages[site.Id] = "Recovery acknowledgment rejected: active worker, target mapping, reservation, or recovery evidence is unsafe."; else _messages[site.Id] = "Recovery acknowledged; evidence retained."; Refresh(); }
        catch (Exception ex) { _messages[site.Id] = ex.Message; }
    }
    private async Task Upload(SiteRecord site, InputFileChangeEventArgs args)
    {
        var parentId = site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId;
        if (!site.TargetAvailable || Busy(parentId)) return;
        _busy.Add(parentId);
        try
        {
            var auth = await AuthenticationState;
            if (!(auth.User.Identity?.IsAuthenticated ?? false)) { _messages[site.Id] = "Authentication required."; return; }
            await using var stream = args.File.OpenReadStream(DeploymentOptions.Value.MaxUploadBytes);
            var result = await Deployments.DeployAsync(site, stream, args.File.Name, CancellationToken.None);
            if (result.Message == ArchiveLayout.WrapperError) _wrapperModal = true;
            else _messages[site.Id] = result.Message;
            Refresh();
        }
        catch (Exception ex) { _messages[site.Id] = ex.Message; }
        finally { _busy.Remove(parentId); Refresh(); }
    }
    private async Task Restore(SiteRecord site)
    {
        var archive = Selected(site.Id);
        if (archive is null || !await JSConfirm()) return;
        var parentId = site.ParentSiteId.Length == 0 ? site.Id : site.ParentSiteId;
        if (!site.TargetAvailable || Busy(parentId)) return;
        _busy.Add(parentId);
        try { var result = await Deployments.RestoreAsync(site, archive, CancellationToken.None); _messages[site.Id] = result.Message; Refresh(); }
        finally { _busy.Remove(parentId); Refresh(); }
    }
    private void CloseWrapperModal() => _wrapperModal = false;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private ValueTask<bool> JSConfirm() => JS.InvokeAsync<bool>("confirm", "Restore this version? The current deployment will be replaced.");
}
<style>
.site-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; padding: 1rem; min-width: 0; }
.site-card { min-width: 0; border: 1px solid #d3d7dc; border-radius: .5rem; padding: .7rem; font-size: .88rem; }
.site-card p { margin: .35rem 0; overflow-wrap: anywhere; }
.site-card h2 { margin: 0; font-size: 1rem; }
.card-head, .actions { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin-bottom: .45rem; }
.card-head { flex-direction: column; align-items: flex-start; }
.actions { display: block; }
.restore-controls, .current-status { min-width: 0; margin: 0; padding: .35rem; border: 1px solid #9ca3af; border-radius: .25rem; }
.restore-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .4rem; width: 100%; }
.restore-controls legend { grid-column: 1 / -1; }
.restore-controls select { width: 100%; min-width: 0; }
.restore-controls legend, .current-status legend { padding: 0 .3rem; }
.current-status { margin: .45rem 0; }
.pill { border-radius: 999px; padding: .15rem .45rem; font-size: .75rem; font-weight: 600; }
.started, .healthy { background: #d1fae5; color: #065f46; }
.degraded { background: #fef3c7; color: #92400e; }
.critical, .unknown { background: #fee2e2; color: #991b1b; }
input, select { padding: .3rem; max-width: 100%; }
.muted { color: #52606d; }
.upload-zone { position: relative; display: flex; flex: 1 1 100%; width: 100%; min-width: 0; gap: .25rem; align-items: center; min-height: 2.5rem; padding: .4rem .65rem; border: 2px dashed #64748b; border-radius: .5rem; cursor: pointer; }
.upload-zone:focus-within, .upload-zone:hover { border-color: #1d4ed8; background: #eff6ff; }
.upload-zone input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.picker-link { color: #1d4ed8; text-decoration: underline; }
.modal-backdrop { position: fixed; inset: 0; display: grid; place-items: center; padding: 1rem; background: rgb(0 0 0 / .55); z-index: 10; }
.modal { width: min(32rem, 100%); padding: 1.5rem; background: white; border-radius: .6rem; box-shadow: 0 1rem 3rem rgb(0 0 0 / .3); }
@@media (max-width: 900px) { .site-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@@media (max-width: 600px) { .site-grid { grid-template-columns: 1fr; } .page-head { align-items: flex-start; } }
</style>
